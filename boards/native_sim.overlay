/ {
	chosen {
		zephyr,canbus = &can_udp0;
	};

	zephyr,user {
		io-channels = <&adc0 0>;
	};

	can_udp0: udp-can {
		compatible = "zephyr,native-linux-udp-can";
		host = "127.0.0.1";
		port = <46100>;
		local-port = <46111>;
		status = "okay";
	};

	pressure_sw: pressure-switch {
		compatible = "power-switch";
		gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
	ultrasonic_sw: ultrasonic-switch {
		compatible = "power-switch";
		gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
	temperature_sw: temperature-switch {
		compatible = "power-switch";
		gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};

	/* Native-sim DS18B20 devices speak W1 through the UART emulator. */
	us0: simulated-ultrasonic {
		status = "okay";
	};

	uart_emul: uart-emul {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		rx-fifo-size = <128>;
		tx-fifo-size = <128>;
		status = "okay";

		w1_0: w1-bus {
			compatible = "zephyr,w1-serial";
			status = "okay";

			temp_0: ds18b200 {
				compatible = "maxim,ds18b20";
				family-code = <0x28>;
				resolution = <12>;
				status = "okay";
			};
			temp_1: ds18b201 {
				compatible = "maxim,ds18b20";
				family-code = <0x28>;
				resolution = <12>;
				status = "okay";
			};
		};
	};
};

&adc0 {
	ref-internal-mv = <3300>;
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

&gpio0 {
	status = "okay";
};
